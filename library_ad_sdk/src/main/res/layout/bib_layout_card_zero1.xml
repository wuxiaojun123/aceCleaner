<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bib_bg_card"
    android:paddingBottom="12dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- 左侧广告大图 -->
    <FrameLayout
        android:id="@+id/media_container"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginTop="10dp"
        android:background="#F5F5F5"
        app:layout_constraintEnd_toStartOf="@+id/icon"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.55"
        tools:background="@tools:sample/backgrounds/scenic" />

    <!-- AD 标记 叠加在左上角 -->
    <TextView
        android:id="@+id/mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bib_bg_mark"
        android:elevation="2dp"
        android:gravity="center"
        android:minWidth="30dp"
        android:minHeight="18dp"
        android:text="@string/string_ad_label"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="@+id/media_container"
        app:layout_constraintTop_toTopOf="@+id/media_container" />

    <!-- 关闭按钮 叠加在右上角 -->
    <ImageView
        android:id="@+id/close"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="0dp"
        android:elevation="2dp"
        android:src="@mipmap/ic_close_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/media_container" />

    <!-- 右侧图标 -->
    <ImageView
        android:id="@+id/icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/media_container"
        app:layout_constraintTop_toTopOf="@+id/media_container"
        tools:src="@tools:sample/avatars" />

    <!-- 标题 -->
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:maxLines="2"
        android:textColor="#FF222222"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon"
        tools:text="专业团队保驾护航" />

    <!-- 描述 -->
    <TextView
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:textColor="#80222222"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/icon"
        app:layout_constraintTop_toBottomOf="@+id/title"
        tools:text="法规不断变化，您的运输依然顺畅。借助FedEx的在线工具与资源，轻松..." />

    <!-- 底部蓝色按钮 -->
    <Button
        android:id="@+id/action"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_ad_btn"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/media_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="1.0"
        tools:text="了解详情" />

</androidx.constraintlayout.widget.ConstraintLayout>
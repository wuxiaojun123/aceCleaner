<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AceClean" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.AceClean.PhotoViewer" parent="Theme.AceClean">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>
    <style name="Theme.AceClean.Onboarding" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>
    <style name="Theme.AceClean.SettingsTips" parent="Theme.AceClean">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>

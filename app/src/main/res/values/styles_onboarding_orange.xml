<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="OnboardingBody" parent="DeviceDetailLabel" />
    <style name="OnboardingPageTitle" parent="DeviceDetailTitle">
        <item name="android:textSize">21sp</item>
    </style>
    <style name="OnboardingSectionTitle" parent="DeviceDetailTitle">
        <item name="android:textSize">24sp</item>
    </style>
    <style name="OnboardingSheetTitle" parent="OnboardingSectionTitle">
        <item name="android:textSize">23sp</item>
    </style>
    <style name="OnboardingMetricValue" parent="DeviceDetailTitle">
        <item name="android:textSize">20sp</item>
    </style>
    <style name="OnboardingScanPercent" parent="DeviceDetailPercent">
        <item name="android:textSize">48sp</item>
    </style>
    <style name="OnboardingScanAmount" parent="DeviceDetailPercent">
        <item name="android:textSize">36sp</item>
        <item name="android:textColor">@color/color_FFFF6B2C</item>
    </style>
    <style name="OnboardingActionText" parent="DeviceDetailTitle">
        <item name="android:gravity">center</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="OnboardingSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/onboarding_sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/onboarding_sheet_exit</item>
    </style>
</resources>

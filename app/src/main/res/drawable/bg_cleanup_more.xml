<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#FFDCE5FF" />
            <stroke android:width="1dp" android:color="#FF8AA7FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#FFF0F6FF"
                android:endColor="#FFEAE7FF" />
            <stroke android:width="1dp" android:color="#FFB7C8FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>

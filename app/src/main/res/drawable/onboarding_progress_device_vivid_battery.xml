<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/background">
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/white" />
            <stroke
                android:width="2dp"
                android:color="@color/color_FFFF6B2C" />
            <corners
                android:radius="4dp" />
        </shape>
    </item>
    <item
        android:id="@android:id/progress"
        android:start="4dp"
        android:end="4dp"
        android:top="4dp"
        android:bottom="4dp">
        <scale
            android:scaleWidth="100%"
            android:gravity="start">
            <shape
                android:shape="rectangle">
                <solid
                    android:color="@color/color_FFFF6B2C" />
                <corners
                    android:radius="1dp" />
            </shape>
        </scale>
    </item>
</layer-list>

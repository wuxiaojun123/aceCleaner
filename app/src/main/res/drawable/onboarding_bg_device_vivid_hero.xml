<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/color_FFFF6B2C" />
            <corners
                android:radius="26dp" />
        </shape>
    </item>
    <item
        android:width="220dp"
        android:height="220dp"
        android:gravity="top|end"
        android:top="-74dp"
        android:end="-65dp">
        <shape
            android:shape="oval">
            <stroke
                android:width="34dp"
                android:color="@color/color_15FFFFFF" />
        </shape>
    </item>
    <item
        android:width="190dp"
        android:height="190dp"
        android:gravity="bottom|end"
        android:bottom="-110dp"
        android:end="-53dp">
        <shape
            android:shape="oval">
            <solid
                android:color="@color/color_FFFFB27C" />
        </shape>
    </item>
</layer-list>

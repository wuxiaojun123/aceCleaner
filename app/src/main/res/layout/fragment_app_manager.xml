        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:text="@string/installed_apps"
            android:textColor="#FF34353B"
            android:textSize="17sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingStart="16dp"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/app_manager_sort_name"
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_app_sort_unselected"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_app_sort_neutral"
                android:paddingHorizontal="12dp"
                android:elevation="2dp"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/sort_name"
                android:textColor="#FF747681"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/app_manager_sort_installation"
                android:layout_width="112dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_app_sort_unselected"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_app_sort_neutral"
                android:paddingHorizontal="12dp"
                android:elevation="2dp"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/sort_installation"
                android:textColor="#FF747681"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/app_manager_sort_size"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_app_sort_unselected"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_app_sort_neutral"
                android:paddingHorizontal="12dp"
                android:elevation="2dp"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/sort_size"
                android:textColor="#FF747681"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/app_manager_sort_last_used"
                android:layout_width="76dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_app_sort_unselected"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_app_sort_neutral"
                android:paddingHorizontal="12dp"
                android:elevation="2dp"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/last_used"
                android:textColor="#FF747681"
                android:textSize="14sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="90dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/app_manager_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

        </ScrollView>

    </LinearLayout>

    <TextView
        android:id="@+id/app_manager_uninstall"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="38dp"
        android:layout_marginEnd="38dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_clean_result_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/uninstall"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />
</FrameLayout>

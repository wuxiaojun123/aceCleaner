<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:background="@drawable/onboarding_bg_overlay_feature_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp">

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:contentDescription="@null"
        android:src="@mipmap/onboarding_icon_smart_junk_cleanup" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:text="@string/string_onboarding_overlay_permission_feature_junk"
        android:textColor="#05080B"
        android:textSize="16sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/duplicate_photo_cleaner_card"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_marginTop="14dp"
    android:background="@drawable/bg_home_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="12dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:src="@drawable/icon_duplicate_photo_cleaner" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:text="@string/duplicate_photo_cleaner"
        android:textColor="#FF353535"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›››"
        android:textColor="#FFE7EDFE"
        android:textSize="28sp"
        android:textStyle="bold" />
</LinearLayout>

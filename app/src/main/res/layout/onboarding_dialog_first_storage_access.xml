<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/onboarding_bg_first_notification_access_dialog">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="195dp"
        android:layout_gravity="top"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/onboarding_competitor_permission_pop_bg" />

    <ImageView
        android:id="@+id/closeButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="end|top"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close"
        android:elevation="8dp"
        android:padding="13dp"
        android:src="@drawable/onboarding_ic_first_notification_access_close" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">

        <ImageView
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:contentDescription="@null"
            android:src="@drawable/onboarding_competitor_permission_storage" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/string_onboarding_first_storage_access_title"
            android:textColor="#16243D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:text="@string/string_onboarding_first_storage_access_description"
            android:textColor="#646B7C"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/allowButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/onboarding_bg_first_storage_access_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/string_onboarding_first_storage_access_allow"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>

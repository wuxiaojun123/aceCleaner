<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="@drawable/onboarding_bg_orange_sheet"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.core.widget.NestedScrollView
        android:fillViewport="false"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:paddingEnd="24dp"
            android:paddingStart="24dp"
            android:paddingTop="28dp">
            <ImageView
                android:background="@drawable/onboarding_bg_detail_icon"
                android:contentDescription="@null"
                android:layout_height="48dp"
                android:layout_width="48dp"
                android:padding="10dp"
                android:src="@drawable/onboarding_ic_junk_folder" />
            <TextView
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_width="match_parent"
                android:text="@string/string_onboarding_first_storage_access_title"
                style="@style/OnboardingSheetTitle" />
            <TextView
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:lineSpacingExtra="4dp"
                android:text="@string/string_onboarding_first_storage_access_description"
                android:textSize="14sp"
                style="@style/OnboardingBody" />
            <TextView
                android:background="@drawable/onboarding_bg_detail_action"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:id="@+id/allowButton"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_width="match_parent"
                android:minHeight="54dp"
                android:padding="12dp"
                android:text="@string/string_onboarding_first_storage_access_allow"
                style="@style/OnboardingActionText" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ImageView
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close"
        android:id="@+id/closeButton"
        android:layout_gravity="top|end"
        android:layout_height="48dp"
        android:layout_width="48dp"
        android:padding="15dp"
        android:src="@drawable/onboarding_ic_first_notification_access_close"
        android:tint="@color/color_FF788392" />
</FrameLayout>

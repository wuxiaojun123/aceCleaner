<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/image_home_not_clean_bg"
        android:tag="system_bar_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/permission_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/go_back"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/permission_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="#FF111111"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageView
            android:id="@+id/permission_image"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_marginTop="68dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/permission_animation"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="42dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone"
            app:lottie_autoPlay="false"
            app:lottie_loop="true" />

        <TextView
            android:id="@+id/permission_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:gravity="center"
            android:textColor="#FF292929"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/permission_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="#FF83838B"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="54dp"
            android:layout_marginEnd="24dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <include
                android:id="@+id/permission_allow"
                layout="@layout/layout_permission_action_animation"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/image_page_bg" />

    <FrameLayout
        android:id="@+id/device_scan_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/device_scan_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleX="1.9"
            android:scaleY="1.9"
            android:scaleType="fitCenter"
            android:transformPivotX="206dp"
            android:transformPivotY="237dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/scan_bg_anim" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/device_scan_animation"
            android:layout_width="370dp"
            android:layout_height="370dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="52dp"
            android:scaleType="centerCrop"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/device_scan_scan_anim" />

        <TextView
            android:id="@+id/device_scan_percent"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="top"
            android:layout_marginTop="450dp"
            android:gravity="center"
            android:text="@string/zero_percentage"
            android:textColor="#FF48ADF7"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="519dp"
            android:gravity="center"
            android:text="@string/scanning_devices_do_not_leave"
            android:textColor="#FF999999"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/device_result_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/feature_back"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible"
            android:contentDescription="@string/go_back" />

        <TextView
            android:id="@+id/feature_title"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_gravity="top|center_horizontal"
            android:gravity="center"
            android:textColor="#FF1C1B22"
            android:textSize="21sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="35dp"
            android:layout_marginTop="90dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/image_device_report" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="161dp"
            android:layout_marginTop="110dp"
            android:layout_marginEnd="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cpu_model_title"
                android:textColor="#FF666666"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/device_cpu_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FF526AFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="227dp"
            android:layout_marginBottom="60dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:scrollbars="none">

            <GridLayout
                android:id="@+id/device_info_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:orientation="horizontal"
                android:paddingBottom="12dp"
                android:rowOrderPreserved="true" />
        </ScrollView>

        <TextView
            android:id="@+id/device_ok_button"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_ram_ok_button"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/ok"
            android:textColor="@color/white"
            android:textSize="21sp"
            android:textStyle="bold" />
    </FrameLayout>
</FrameLayout>

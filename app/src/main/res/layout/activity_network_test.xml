<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent">
    <View
        android:background="@drawable/bg_network_test_page"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:tag="system_bar_background" />
    <LinearLayout
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:paddingTop="8dp">
        <include
            android:id="@+id/feature_header"
            layout="@layout/layout_feature_header" />
        <androidx.core.widget.NestedScrollView
            android:clipToPadding="false"
            android:fillViewport="true"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:paddingBottom="16dp"
                android:paddingHorizontal="24dp"
                android:paddingTop="22dp">
                <TextView
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:letterSpacing="0.12"
                    android:text="@string/string_network_overline"
                    android:textColor="@color/color_FF727981"
                    android:textSize="11sp" />
                <TextView
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:text="@string/string_network_intro"
                    android:textColor="@color/color_FF727981"
                    android:textSize="14sp" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_width="match_parent">
                    <FrameLayout
                        android:id="@+id/network_gauge_container"
                        android:layout_height="0dp"
                        android:layout_width="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_max="264dp">
                        <com.nice.aceclean.ui.widget.SpeedTestGaugeView
                            android:id="@+id/network_test_progress"
                            android:layout_height="match_parent"
                            android:layout_width="match_parent"
                            app:gaugeProgressColor="@color/color_FFEE6229"
                            app:gaugeStrokeWidth="6dp"
                            app:gaugeTrackColor="@color/color_FFF2E6DE" />
                        <LinearLayout
                            android:gravity="center"
                            android:layout_height="match_parent"
                            android:layout_width="match_parent"
                            android:orientation="vertical"
                            android:padding="22dp">
                            <LinearLayout
                                android:gravity="center"
                                android:id="@+id/network_live_speed_group"
                                android:layout_height="wrap_content"
                                android:layout_width="match_parent"
                                android:orientation="vertical">
                                <TextView
                                    android:fontFamily="sans-serif-medium"
                                    android:gravity="center"
                                    android:id="@+id/network_live_speed"
                                    android:layout_height="76dp"
                                    android:layout_width="match_parent"
                                    android:letterSpacing="-0.04"
                                    android:maxLines="1"
                                    android:text="@string/string_network_zero"
                                    android:textColor="@color/color_FF252A31"
                                    android:textSize="62sp" />
                                <TextView
                                    android:layout_height="wrap_content"
                                    android:layout_width="wrap_content"
                                    android:letterSpacing="0.06"
                                    android:text="@string/string_network_speed_unit"
                                    android:textColor="@color/color_FF727981"
                                    android:textSize="13sp" />
                            </LinearLayout>
                            <LinearLayout
                                android:gravity="center"
                                android:id="@+id/network_test_success_group"
                                android:layout_height="wrap_content"
                                android:layout_width="match_parent"
                                android:orientation="vertical"
                                android:visibility="gone">
                                <com.nice.aceclean.ui.widget.CheckmarkAnimationView
                                    android:background="@drawable/bg_network_test_soft"
                                    android:id="@+id/network_test_success"
                                    android:layout_height="60dp"
                                    android:layout_width="60dp"
                                    android:visibility="gone"
                                    app:checkmarkColor="@color/color_FFEE6229" />
                                <TextView
                                    android:fontFamily="sans-serif-medium"
                                    android:gravity="center"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:layout_width="match_parent"
                                    android:text="@string/string_network_complete_title"
                                    android:textColor="@color/color_FF252A31"
                                    android:textSize="21sp" />
                            </LinearLayout>
                            <TextView
                                android:accessibilityLiveRegion="polite"
                                android:gravity="center"
                                android:id="@+id/network_test_status"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:layout_width="match_parent"
                                android:text="@string/network_test_ready"
                                android:textColor="@color/color_FF727981"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_width="match_parent"
                    android:orientation="horizontal">
                    <TextView
                        android:background="@drawable/bg_network_test_step"
                        android:id="@+id/network_step_ping"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="8dp"
                        android:text="@string/string_network_step_ping"
                        android:textColor="@color/network_test_step_text"
                        android:textSize="11sp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="2" />
                    <View
                        android:background="@color/color_FFEBE9E5"
                        android:layout_height="1dp"
                        android:layout_width="10dp" />
                    <TextView
                        android:background="@drawable/bg_network_test_step"
                        android:id="@+id/network_step_download"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="8dp"
                        android:text="@string/string_network_step_download"
                        android:textColor="@color/network_test_step_text"
                        android:textSize="11sp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="2" />
                    <View
                        android:background="@color/color_FFEBE9E5"
                        android:layout_height="1dp"
                        android:layout_width="10dp" />
                    <TextView
                        android:background="@drawable/bg_network_test_step"
                        android:id="@+id/network_step_upload"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="8dp"
                        android:text="@string/string_network_step_upload"
                        android:textColor="@color/network_test_step_text"
                        android:textSize="11sp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="2" />
                </LinearLayout>
                <LinearLayout
                    android:background="@drawable/bg_network_test_results"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:paddingVertical="20dp">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:orientation="vertical">
                        <ImageView
                            android:contentDescription="@null"
                            android:id="@+id/network_ping_icon"
                            android:layout_height="20dp"
                            android:layout_width="20dp"
                            android:src="@drawable/ic_network_test_ping_line" />
                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:layout_width="wrap_content"
                            android:text="@string/ping"
                            android:textColor="@color/color_FF727981"
                            android:textSize="12sp" />
                        <TextView
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:id="@+id/network_ping"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:maxLines="1"
                            android:text="@string/string_network_number_placeholder"
                            android:textColor="@color/color_FF252A31"
                            android:textSize="25sp" />
                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:layout_width="wrap_content"
                            android:text="@string/string_network_ping_unit"
                            android:textColor="@color/color_FF727981"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <View
                        android:background="@color/color_FFEBE9E5"
                        android:layout_gravity="center_vertical"
                        android:layout_height="66dp"
                        android:layout_width="1dp" />
                    <LinearLayout
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:orientation="vertical">
                        <ImageView
                            android:contentDescription="@null"
                            android:id="@+id/network_download_icon"
                            android:layout_height="20dp"
                            android:layout_width="20dp"
                            android:src="@drawable/ic_network_test_download_line" />
                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:layout_width="wrap_content"
                            android:text="@string/string_network_download"
                            android:textColor="@color/color_FF727981"
                            android:textSize="12sp" />
                        <TextView
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:id="@+id/network_download"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:maxLines="1"
                            android:text="@string/string_network_number_placeholder"
                            android:textColor="@color/color_FF252A31"
                            android:textSize="25sp" />
                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:layout_width="wrap_content"
                            android:text="@string/string_network_speed_unit"
                            android:textColor="@color/color_FF727981"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <View
                        android:background="@color/color_FFEBE9E5"
                        android:layout_gravity="center_vertical"
                        android:layout_height="66dp"
                        android:layout_width="1dp" />
                    <LinearLayout
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:orientation="vertical">
                        <ImageView
                            android:contentDescription="@null"
                            android:id="@+id/network_upload_icon"
                            android:layout_height="20dp"
                            android:layout_width="20dp"
                            android:src="@drawable/ic_network_test_upload_line" />
                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:layout_width="wrap_content"
                            android:text="@string/string_network_upload"
                            android:textColor="@color/color_FF727981"
                            android:textSize="12sp" />
                        <TextView
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:id="@+id/network_upload"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:maxLines="1"
                            android:text="@string/string_network_number_placeholder"
                            android:textColor="@color/color_FF252A31"
                            android:textSize="25sp" />
                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:layout_width="wrap_content"
                            android:text="@string/string_network_speed_unit"
                            android:textColor="@color/color_FF727981"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:gravity="center"
                    android:id="@+id/network_results_hint"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:text="@string/string_network_results_hint"
                    android:textColor="@color/color_FF727981"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <TextView
            android:background="@drawable/bg_network_test_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:id="@+id/network_test_button"
            android:layout_height="55dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:text="@string/start_test"
            android:textColor="@color/network_test_button_text"
            android:textSize="16sp" />
        <TextView
            android:gravity="center"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:text="@string/network_test_data_note"
            android:textColor="@color/color_FF727981"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>

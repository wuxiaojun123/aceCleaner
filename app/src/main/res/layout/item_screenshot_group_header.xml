<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="10dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/picture_group_month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF202126" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/picture_group_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#FFA0A1A6" android:textSize="13sp" />
    </LinearLayout>
    <CheckBox android:id="@+id/picture_group_all" android:layout_width="wrap_content" android:layout_height="46dp" android:buttonTint="#FF191733" android:gravity="center" android:text="@string/all" android:textColor="#FF202126" android:textSize="14sp" />
</LinearLayout>

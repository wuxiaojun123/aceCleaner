<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="centerCrop" android:src="@drawable/image_home_not_clean_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout android:layout_width="match_parent" android:layout_height="56dp">
            <ImageButton android:id="@+id/picture_back" android:layout_width="52dp" android:layout_height="match_parent" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_back" android:padding="16dp" android:src="@drawable/ic_back" />
            <TextView android:id="@+id/picture_title" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center" android:text="@string/picture" android:textColor="#FF202126" android:textSize="18sp" android:textStyle="bold" />
            <CheckBox android:id="@+id/picture_select_all" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="end" android:layout_marginEnd="12dp" android:buttonTint="#FF191733" android:gravity="center" android:text="@string/all" android:textColor="#FF202126" android:textSize="15sp" />
        </FrameLayout>

        <LinearLayout android:id="@+id/picture_tabs" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginStart="19dp" android:layout_marginTop="10dp" android:layout_marginEnd="19dp" android:background="@drawable/bg_media_tab_container" android:orientation="horizontal">
            <TextView android:id="@+id/picture_tab_screenshot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_media_tab" android:gravity="center" android:text="@string/screenshot" android:textColor="#FF34353A" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/picture_tab_others" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_media_tab" android:gravity="center" android:text="@string/others" android:textColor="#FF66676C" android:textSize="16sp" />
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/picture_list" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingStart="19dp" android:paddingTop="16dp" android:paddingEnd="19dp" android:paddingBottom="12dp" android:scrollbars="none" />
            <TextView android:id="@+id/picture_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:text="@string/no_picture_files_found" android:textColor="#FF92939A" android:textSize="14sp" android:visibility="gone" />
        </FrameLayout>

        <TextView android:id="@+id/picture_clean" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginStart="38dp" android:layout_marginTop="8dp" android:layout_marginEnd="38dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_clean_result_button" android:gravity="center" android:text="@string/clean" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_notification_manager_screen"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_notif_halo">

        <ProgressBar
            android:id="@+id/notification_cleaning_progress"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/notification_manager_amber" />

        <ImageView
            android:id="@+id/notification_cleaning_success_icon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_clean_success"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/notification_cleaning_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/notif_cleaning_title"
        android:textColor="@color/home_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notification_cleaning_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/notif_cleaning_subtitle"
        android:textColor="@color/notification_manager_muted"
        android:textSize="14sp" />
</LinearLayout>

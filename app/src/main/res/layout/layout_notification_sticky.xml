<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/notification_sticky_height"
    android:baselineAligned="false"
    android:gravity="center"
    android:orientation="horizontal">

    <!--android:background="@color/color_EBEDFF"-->

    <LinearLayout
        android:id="@+id/btnlargeFiles"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="26dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/hkep_ic_notify_clean_up" />

            <TextView
                android:id="@+id/badgePhotos"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="end|top"
                android:background="@drawable/bg_notification_badge"
                android:gravity="center"
                android:text="@string/notification_badge_sample"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvLabelLargeFiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_large_files"
            android:textColor="@color/black"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnPhotos"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="26dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/hkep_ic_notify_screenshot" />

            <TextView
                android:id="@+id/badgeVideos"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="end|top"
                android:background="@drawable/bg_notification_badge"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvLabelPhotos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_photos"
            android:textColor="@color/black"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnForlder"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="26dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/hkep_ic_notify_empty" />

            <TextView
                android:id="@+id/badgeJunk"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="end|top"
                android:background="@drawable/bg_notification_badge"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvLabelForlder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_empty"
            android:textColor="@color/black"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnNotify"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="26dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/hkep_ic_notify_msg"
                />

            <TextView
                android:id="@+id/badgeRecovered"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="end|top"
                android:background="@drawable/bg_notification_badge"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvLabelNotify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_notifications"
            android:textColor="@color/black"
            android:textSize="10sp" />

    </LinearLayout>

    <TextView
        android:layout_gravity="center_vertical"
        android:background="@color/notification_sticky_divider"
        android:layout_width="1dp"
        android:layout_height="32dp"
        android:layout_marginStart="10dp"/>

    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/tv_network_speed"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tv_network_speed_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tv_network_speed_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>


</LinearLayout>

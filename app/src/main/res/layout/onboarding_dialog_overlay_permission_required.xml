<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="@drawable/onboarding_bg_orange_sheet"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.core.widget.NestedScrollView
        android:fillViewport="false"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:paddingEnd="24dp"
            android:paddingStart="24dp"
            android:paddingTop="28dp">
            <ImageView
                android:background="@drawable/onboarding_bg_detail_icon"
                android:contentDescription="@null"
                android:layout_height="48dp"
                android:layout_width="48dp"
                android:padding="10dp"
                android:src="@drawable/onboarding_ic_detail_phone" />
            <TextView
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_width="match_parent"
                android:text="@string/string_onboarding_overlay_permission_dialog_permission_label"
                style="@style/OnboardingSheetTitle" />
            <TextView
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:lineSpacingExtra="4dp"
                android:text="@string/string_onboarding_overlay_permission_back_description"
                android:textSize="14sp"
                style="@style/OnboardingBody" />
            <TextView
                android:background="@drawable/onboarding_bg_detail_action"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:id="@+id/fixNowButton"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_width="match_parent"
                android:minHeight="54dp"
                android:padding="12dp"
                android:text="@string/string_onboarding_fix_now"
                style="@style/OnboardingActionText" />
            <TextView
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:id="@+id/notNowButton"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent"
                android:minHeight="48dp"
                android:text="@string/string_onboarding_overlay_permission_dialog_not_now"
                style="@style/OnboardingBody" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_FFFAF9F7"
    tools:context=".ui.onboarding.DeviceStatusDetailActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@id/continueButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="3dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp">

                    <TextView
                        android:id="@+id/titleView"
                        style="@style/DeviceDetailTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/app_name"
                        android:textSize="21sp" />

                    <TextView
                        android:id="@+id/skipButton"
                        style="@style/DeviceDetailTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:text="@string/string_onboarding_overlay_permission_skip"
                        android:textColor="@color/color_FFFF6B2C"
                        android:textSize="16sp"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/deviceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/onboarding_bg_device_status_card"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:id="@+id/manufacturerGroup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:background="@drawable/onboarding_bg_detail_icon"
                            android:contentDescription="@null"
                            android:padding="12dp"
                            android:src="@drawable/onboarding_ic_detail_phone" />

                        <TextView
                            android:id="@+id/deviceName"
                            style="@style/DeviceDetailTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:textSize="17sp"
                            tools:text="HONOR" />

                        <TextView
                            android:id="@+id/deviceModel"
                            style="@style/DeviceDetailLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center"
                            tools:text="BRP-AN80" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="112dp"
                        android:background="@color/color_FFE8E9ED" />

                    <LinearLayout
                        android:id="@+id/androidGroup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:background="@drawable/onboarding_bg_detail_icon"
                            android:contentDescription="@null"
                            android:padding="12dp"
                            android:src="@drawable/onboarding_ic_detail_android" />

                        <TextView
                            android:id="@+id/androidVersion"
                            style="@style/DeviceDetailTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:textSize="17sp"
                            tools:text="Android 15" />

                        <TextView
                            android:id="@+id/androidRelease"
                            style="@style/DeviceDetailLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center"
                            tools:text="REL" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ramCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/onboarding_bg_device_status_card"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ramIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/onboarding_bg_detail_icon"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/onboarding_ic_detail_chip" />

                        <TextView
                            style="@style/DeviceDetailTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/ram" />

                        <TextView
                            android:id="@+id/ramPercent"
                            style="@style/DeviceDetailPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="62%" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/ramProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="6dp"
                        android:indeterminateOnly="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/onboarding_progress_detail_orange"
                        tools:progress="62" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/DeviceDetailLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/string_onboarding_device_status_used" />

                        <TextView
                            android:id="@+id/ramValue"
                            style="@style/DeviceDetailLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            tools:text="7.48GB" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            style="@style/DeviceDetailLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/string_onboarding_device_status_total" />

                        <TextView
                            android:id="@+id/ramTotalValue"
                            style="@style/DeviceDetailLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            tools:text="12.01GB" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/storageCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/onboarding_bg_device_status_card"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/storageIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/onboarding_bg_detail_icon"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/onboarding_ic_detail_storage" />

                        <TextView
                            style="@style/DeviceDetailTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/storage" />

                        <TextView
                            android:id="@+id/storagePercent"
                            style="@style/DeviceDetailPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="12%" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/storageProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="6dp"
                        android:indeterminateOnly="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/onboarding_progress_detail_orange"
                        tools:progress="12" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/DeviceDetailLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/string_onboarding_device_status_used" />

                        <TextView
                            android:id="@+id/storageValue"
                            style="@style/DeviceDetailLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            tools:text="480MB" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            style="@style/DeviceDetailLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/string_onboarding_device_status_total" />

                        <TextView
                            android:id="@+id/storageTotalValue"
                            style="@style/DeviceDetailLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            tools:text="4GB" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/batteryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/onboarding_bg_device_status_card"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/batteryIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/onboarding_bg_detail_icon"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/onboarding_ic_detail_battery" />

                        <TextView
                            style="@style/DeviceDetailTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/notification_battery" />

                        <TextView
                            android:id="@+id/batteryPercent"
                            style="@style/DeviceDetailPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="100%" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/batteryProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="6dp"
                        android:indeterminateOnly="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/onboarding_progress_detail_orange"
                        tools:progress="100" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/DeviceDetailLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/string_onboarding_device_status_battery_status" />

                        <TextView
                            android:id="@+id/batteryValue"
                            style="@style/DeviceDetailLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            tools:text="Full" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cpuCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/onboarding_bg_device_status_card"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/cpuIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/onboarding_bg_detail_icon"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/onboarding_ic_detail_chip" />

                        <TextView
                            style="@style/DeviceDetailTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/string_onboarding_first_device_cpu" />
                    </LinearLayout>

                    <View
                        android:id="@+id/cpuDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/color_FFF1F1F3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">

                        <TextView
                            style="@style/DeviceDetailLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="@string/string_onboarding_device_status_cpu_model" />

                        <TextView
                            android:id="@+id/cpuModelValue"
                            style="@style/DeviceDetailValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:maxWidth="168dp"
                            tools:text="arm64-v8a" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_FFF1F1F3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">

                        <TextView
                            style="@style/DeviceDetailLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="@string/string_onboarding_device_status_cpu_frequency" />

                        <TextView
                            android:id="@+id/cpuFrequencyValue"
                            style="@style/DeviceDetailValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:maxWidth="168dp"
                            tools:text="1804 MHz" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_FFF1F1F3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">

                        <TextView
                            style="@style/DeviceDetailLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="@string/string_onboarding_device_status_cpu_cores" />

                        <TextView
                            android:id="@+id/cpuCoresValue"
                            style="@style/DeviceDetailValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:maxWidth="168dp"
                            tools:text="8" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/screenCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/onboarding_bg_device_status_card"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/screenIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/onboarding_bg_detail_icon"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/onboarding_ic_detail_screen" />

                        <TextView
                            style="@style/DeviceDetailTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/string_onboarding_first_device_screen" />
                    </LinearLayout>

                    <View
                        android:id="@+id/screenDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/color_FFF1F1F3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">

                        <TextView
                            style="@style/DeviceDetailLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="@string/screen_resolution" />

                        <TextView
                            android:id="@+id/screenResolutionValue"
                            style="@style/DeviceDetailValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:maxWidth="168dp"
                            tools:text="1224x2700" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_FFF1F1F3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">

                        <TextView
                            style="@style/DeviceDetailLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="@string/string_onboarding_device_status_screen_dpi" />

                        <TextView
                            android:id="@+id/screenDpiValue"
                            style="@style/DeviceDetailValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:maxWidth="168dp"
                            tools:text="520DPI" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_FFF1F1F3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">

                        <TextView
                            style="@style/DeviceDetailLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="@string/string_onboarding_device_status_screen_refresh_rate" />

                        <TextView
                            android:id="@+id/screenRefreshValue"
                            style="@style/DeviceDetailValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:maxWidth="168dp"
                            tools:text="60Hz" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <FrameLayout
            android:id="@+id/continueButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/onboarding_bg_detail_action"
            android:clickable="true"
            android:clipToOutline="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:minHeight="52dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="52dp"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/onboarding_ic_detail_broom" />

                <TextView
                    style="@style/DeviceDetailTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/string_onboarding_device_status_clean_junk_files"
                    android:textColor="@color/white"
                    android:textSize="17sp" />
            </LinearLayout>

            <View
                android:id="@+id/continueButtonShine"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/onboarding_bg_quick_scan_shine"
                android:rotation="-20"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>

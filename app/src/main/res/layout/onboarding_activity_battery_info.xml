<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@color/color_FFFAF9F7"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/titleView"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_width="0dp"
        android:minHeight="48dp"
        android:text="@string/battery_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/OnboardingPageTitle" />
    <ImageView
        android:contentDescription="@string/go_back"
        android:id="@+id/backButton"
        android:layout_height="48dp"
        android:layout_width="44dp"
        android:src="@drawable/onboarding_ic_first_complete_back"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <FrameLayout
        android:background="@drawable/onboarding_bg_detail_action"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:id="@+id/bottomActionContainer"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_width="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/checkNowButton"
            android:layout_height="match_parent"
            android:layout_width="match_parent"
            android:text="@string/string_onboarding_battery_info_check_now"
            style="@style/OnboardingActionText" />
        <View
            android:background="@drawable/onboarding_bg_quick_scan_shine"
            android:id="@+id/checkNowButtonShine"
            android:layout_gravity="start|center_vertical"
            android:layout_height="match_parent"
            android:layout_width="100dp"
            android:rotation="-20"
            android:visibility="gone" />
    </FrameLayout>
    <androidx.core.widget.NestedScrollView
        android:clipToPadding="false"
        android:fillViewport="true"
        android:layout_height="0dp"
        android:layout_width="0dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottomActionContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleView">
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:paddingEnd="16dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp">
            <com.airbnb.lottie.LottieAnimationView
                android:contentDescription="@null"
                android:id="@+id/scanAnimation"
                android:importantForAccessibility="no"
                android:layout_gravity="center_horizontal"
                android:layout_height="190dp"
                android:layout_width="190dp"
                app:lottie_autoPlay="false"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/onboarding_orange_battery_scan" />
            <TextView
                android:gravity="center"
                android:id="@+id/batteryPercent"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:text="@string/string_onboarding_literal_3"
                android:textSize="42sp"
                style="@style/OnboardingScanPercent" />
            <TextView
                android:gravity="center"
                android:id="@+id/batteryEstimate"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:text="@string/string_onboarding_battery_estimated_calculating"
                style="@style/OnboardingBody" />
            <LinearLayout
                android:background="@drawable/onboarding_bg_device_status_card"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:padding="12dp">
                <ImageView
                    android:background="@drawable/onboarding_bg_detail_icon"
                    android:contentDescription="@null"
                    android:layout_height="34dp"
                    android:layout_width="34dp"
                    android:padding="6dp"
                    android:src="@drawable/onboarding_ic_detail_battery" />
                <TextView
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:text="@string/string_onboarding_battery_status_label"
                    style="@style/OnboardingBody" />
                <TextView
                    android:id="@+id/batteryStatusValue"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_width="wrap_content"
                    android:text="@string/string_onboarding_literal_2"
                    style="@style/OnboardingBody" />
            </LinearLayout>
            <LinearLayout
                android:baselineAligned="false"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:orientation="horizontal">
                <include
                    android:id="@+id/temperatureCard"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    layout="@layout/onboarding_item_battery_info_metric" />
                <include
                    android:id="@+id/voltageCard"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    layout="@layout/onboarding_item_battery_info_metric" />
            </LinearLayout>
            <LinearLayout
                android:baselineAligned="false"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:orientation="horizontal">
                <include
                    android:id="@+id/typeCard"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    layout="@layout/onboarding_item_battery_info_metric" />
                <include
                    android:id="@+id/powerCard"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    layout="@layout/onboarding_item_battery_info_metric" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_width="wrap_content"
                android:orientation="horizontal">
                <ImageView
                    android:background="@drawable/onboarding_bg_detail_icon"
                    android:contentDescription="@null"
                    android:layout_height="28dp"
                    android:layout_width="28dp"
                    android:padding="6dp"
                    android:src="@drawable/onboarding_ic_detail_android" />
                <TextView
                    android:id="@+id/checkedUserCount"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_width="wrap_content"
                    android:text="@string/string_onboarding_battery_checked_user_count"
                    android:textSize="12sp"
                    style="@style/DeviceDetailTitle" />
                <TextView
                    android:id="@+id/checkedTodayText"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_width="wrap_content"
                    android:text="@string/string_onboarding_battery_users_checked_today"
                    android:textSize="12sp"
                    style="@style/OnboardingBody" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

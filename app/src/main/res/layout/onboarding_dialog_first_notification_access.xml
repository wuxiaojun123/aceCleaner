<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/onboarding_bg_first_notification_access_dialog">

    <ImageView
        android:id="@+id/closeButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="end|top"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close"
        android:padding="13dp"
        android:src="@drawable/onboarding_ic_first_notification_access_close" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@null"
            android:src="@drawable/onboarding_competitor_permission_manage_notice" />

        <TextView
            android:id="@+id/notificationAccessTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/string_onboarding_first_notification_access_title"
            android:textColor="#16243D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notificationAccessDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:text="@string/string_onboarding_first_notification_access_description"
            android:textColor="#667085"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/grantAccessButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/onboarding_bg_first_notification_access_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/string_onboarding_first_notification_access_grant"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>

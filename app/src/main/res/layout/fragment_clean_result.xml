<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFDEEDFF">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFDEEDFF"
        android:importantForAccessibility="no"
        android:tag="system_bar_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp">

            <ImageView
                android:id="@+id/clean_result_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_cleanup_toolbar_button"
                android:contentDescription="@string/go_back"
                android:padding="11dp"
                android:src="@drawable/ic_back"
                android:tint="#FF0D1014"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="54dp"
                android:layout_marginEnd="54dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/string_cleanup_title"
                android:textColor="#FF111216"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/cleanup_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_cleanup_toolbar_button"
                android:contentDescription="@string/settings"
                android:padding="11dp"
                android:src="@drawable/ic_settings"
                android:tint="#FF0D1014"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.nice.aceclean.ui.widget.CleanupMeterView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="25dp"
                android:layout_marginEnd="25dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:translationY="-12dp">

                <TextView
                    android:id="@+id/cleanup_total_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:letterSpacing="-0.04"
                    android:text="@string/zero_bytes"
                    android:textColor="#FF111216"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="center"
                    android:text="@string/string_cleanup_system_cleaning"
                    android:textColor="#FF111216"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cleanup_sheet"
            android:orientation="vertical"
            android:paddingStart="25dp"
            android:paddingTop="22dp"
            android:paddingEnd="25dp"
            android:paddingBottom="36dp">

            <View
                android:layout_width="77dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_cleanup_handle"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/cleanup_scan_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:textColor="#FFB06B3B"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cleanup_categories"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/remove_button"
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_cleanup_primary"
                android:backgroundTint="@null"
                android:elevation="5dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/string_cleanup_clean_now"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

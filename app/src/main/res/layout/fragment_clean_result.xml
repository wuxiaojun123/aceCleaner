<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/image_home_not_clean_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <ImageButton
                android:id="@+id/clean_result_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/go_back"
                android:padding="8dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/one_click_clean"
                android:textColor="#FF090909"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/cleanup_total_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/zero_bytes"
            android:textColor="#FF333333"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cleanup_removable_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="center"
            android:text="@string/removable"
            android:textColor="#FF3C3C3C"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/cleanup_scan_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/scanning"
            android:textColor="#FF858791"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/cleanup_scan_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="@string/scan_incomplete"
            android:textColor="#FFB06B3B"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/cleanup_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_junk"
                android:textColor="#FF34353B"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cleanup_rescan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="26dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="26dp"
                android:background="@drawable/bg_clean_result_button"
                android:gravity="center"
                android:text="@string/try_again"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cleanup_system_cache"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="26dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="26dp"
                android:background="@drawable/bg_large_filter"
                android:gravity="center"
                android:text="@string/clear_app_cache"
                android:textColor="#FF34353B"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/cleanup_find_large_files"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="26dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="26dp"
                android:background="@drawable/bg_large_filter"
                android:gravity="center"
                android:text="@string/big_file_cleaner"
                android:textColor="#FF34353B"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cleanup_cache_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="31dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cache"
                android:textColor="#FF393939"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cleanup_cache_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zero_bytes"
                android:textColor="#FF9C9C9C"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/cleanup_cache_check"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_clean_check"
                android:contentDescription="@string/selected"
                android:padding="4dp"
                android:src="@drawable/ic_clean_check" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cleanup_ad_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ad_files"
                android:textColor="#FF393939"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cleanup_ad_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zero_bytes"
                android:textColor="#FF9C9C9C"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/cleanup_ad_check"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_clean_check"
                android:contentDescription="@string/selected"
                android:padding="4dp"
                android:src="@drawable/ic_clean_check" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cleanup_temp_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/temporary_files"
                android:textColor="#FF393939"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cleanup_temp_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_junk"
                android:textColor="#FF9C9C9C"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/cleanup_temp_check"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_clean_check"
                android:contentDescription="@string/selected"
                android:padding="4dp"
                android:src="@drawable/ic_clean_check" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cleanup_apk_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/obsolete_apk_files"
                android:textColor="#FF393939"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cleanup_apk_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zero_bytes"
                android:textColor="#FF9C9C9C"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/cleanup_apk_check"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_clean_check"
                android:contentDescription="@string/selected"
                android:padding="4dp"
                android:src="@drawable/ic_clean_check" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cleanup_residual_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/residual_files"
                android:textColor="#FF393939"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cleanup_residual_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zero_bytes"
                android:textColor="#FF9C9C9C"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/cleanup_residual_check"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_clean_check"
                android:contentDescription="@string/selected"
                android:padding="4dp"
                android:src="@drawable/ic_clean_check" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cleanup_empty_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/empty_files"
                android:textColor="#FF393939"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cleanup_empty_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_junk"
                android:textColor="#FF9C9C9C"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/cleanup_empty_check"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_clean_check"
                android:contentDescription="@string/selected"
                android:padding="4dp"
                android:src="@drawable/ic_clean_check" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cleanup_more_row"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_cleanup_more"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/remove_more"
                android:textColor="#FF4F5FE7"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/more_indicator"
                android:textColor="#FF6B7CFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/remove_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_clean_result_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/clean"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@color/color_FFFAF9F7"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/go_back"
        android:id="@+id/backButton"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_width="44dp"
        android:padding="11dp"
        android:src="@drawable/onboarding_ic_first_complete_back"
        android:tint="@color/color_FF171D27"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/titleView"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="52dp"
        android:layout_marginTop="4dp"
        android:layout_width="0dp"
        android:minHeight="48dp"
        android:text="@string/string_onboarding_first_junk_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/OnboardingPageTitle" />
    <androidx.core.widget.NestedScrollView
        android:clipToPadding="false"
        android:fillViewport="true"
        android:id="@+id/contentScroll"
        android:layout_height="0dp"
        android:layout_width="0dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleView">
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:paddingEnd="16dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp">
            <com.airbnb.lottie.LottieAnimationView
                android:contentDescription="@null"
                android:id="@+id/finishImage"
                android:importantForAccessibility="no"
                android:layout_gravity="center_horizontal"
                android:layout_height="185dp"
                android:layout_width="185dp"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                app:lottie_rawRes="@raw/onboarding_orange_complete" />
            <TextView
                android:gravity="center"
                android:id="@+id/resultTitle"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:text="@string/string_onboarding_first_junk_complete_title"
                style="@style/OnboardingSectionTitle" />
            <TextView
                android:gravity="center"
                android:id="@+id/resultMessage"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:lineSpacingExtra="3dp"
                style="@style/OnboardingBody" />
            <LinearLayout
                android:background="@drawable/onboarding_bg_device_status_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:id="@+id/appProcessCard"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:padding="12dp">
                <ImageView
                    android:background="@drawable/onboarding_bg_detail_icon"
                    android:contentDescription="@null"
                    android:layout_height="34dp"
                    android:layout_width="34dp"
                    android:padding="6dp"
                    android:src="@drawable/onboarding_ic_detail_chip" />
                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:text="@string/string_onboarding_first_complete_choice_badge_process"
                        android:textColor="@color/color_FF788392"
                        android:textSize="10sp"
                        style="@style/OnboardingBody" />
                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:text="@string/string_onboarding_first_complete_app_process"
                        style="@style/DeviceDetailTitle" />
                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/string_onboarding_first_complete_app_process_description"
                        android:textSize="11sp"
                        style="@style/OnboardingBody" />
                </LinearLayout>
                <ImageView
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/string_onboarding_first_complete_app_process"
                    android:id="@+id/appProcessButton"
                    android:layout_height="48dp"
                    android:layout_width="44dp"
                    android:padding="14dp"
                    android:rotation="180"
                    android:src="@drawable/onboarding_ic_first_complete_back"
                    android:tint="@color/color_FF788392" />
            </LinearLayout>
            <LinearLayout
                android:background="@drawable/onboarding_bg_device_status_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:id="@+id/notificationBlockerCard"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:padding="12dp">
                <ImageView
                    android:background="@drawable/onboarding_bg_detail_icon"
                    android:contentDescription="@null"
                    android:layout_height="34dp"
                    android:layout_width="34dp"
                    android:padding="6dp"
                    android:src="@drawable/icon_notification" />
                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:text="@string/string_onboarding_first_complete_choice_badge_battery"
                        android:textColor="@color/color_FF788392"
                        android:textSize="10sp"
                        style="@style/OnboardingBody" />
                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:text="@string/string_onboarding_first_complete_notification_blocker"
                        style="@style/DeviceDetailTitle" />
                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/string_onboarding_first_complete_notification_description"
                        android:textSize="11sp"
                        style="@style/OnboardingBody" />
                </LinearLayout>
                <ImageView
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/string_onboarding_first_complete_notification_blocker"
                    android:id="@+id/notificationBlockerButton"
                    android:layout_height="48dp"
                    android:layout_width="44dp"
                    android:padding="14dp"
                    android:rotation="180"
                    android:src="@drawable/onboarding_ic_first_complete_back"
                    android:tint="@color/color_FF788392" />
            </LinearLayout>
            <LinearLayout
                android:background="@drawable/onboarding_bg_device_status_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:id="@+id/batteryInfoCard"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:padding="12dp">
                <ImageView
                    android:background="@drawable/onboarding_bg_detail_icon"
                    android:contentDescription="@null"
                    android:layout_height="34dp"
                    android:layout_width="34dp"
                    android:padding="6dp"
                    android:src="@drawable/onboarding_ic_detail_battery" />
                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:text="@string/string_onboarding_first_complete_choice_badge"
                        android:textColor="@color/color_FF788392"
                        android:textSize="10sp"
                        style="@style/OnboardingBody" />
                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:text="@string/battery_info"
                        style="@style/DeviceDetailTitle" />
                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/string_onboarding_first_complete_battery_description"
                        android:textSize="11sp"
                        style="@style/OnboardingBody" />
                </LinearLayout>
                <ImageView
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/battery_info"
                    android:id="@+id/batteryInfoButton"
                    android:layout_height="48dp"
                    android:layout_width="44dp"
                    android:padding="14dp"
                    android:rotation="180"
                    android:src="@drawable/onboarding_ic_first_complete_back"
                    android:tint="@color/color_FF788392" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/adContainer"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="centerCrop" android:src="@drawable/image_home_not_clean_bg" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="56dp">
            <ImageButton android:id="@+id/large_back" android:layout_width="52dp" android:layout_height="match_parent" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_back" android:padding="16dp" android:src="@drawable/ic_back" />
            <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center" android:text="@string/large_files" android:textColor="#FF202126" android:textSize="18sp" android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout android:id="@+id/large_filter_bar" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginStart="19dp" android:layout_marginTop="10dp" android:layout_marginEnd="19dp" android:background="@drawable/bg_large_filter" android:orientation="horizontal">
            <TextView android:id="@+id/large_type_filter" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/all_types" android:textColor="#FF3A3B40" android:textSize="14sp" />
            <TextView android:id="@+id/large_size_filter" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/zero_bytes" android:textColor="#FF3A3B40" android:textSize="14sp" />
            <TextView android:id="@+id/large_time_filter" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/all_time" android:textColor="#FF3A3B40" android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/large_file_list" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingStart="19dp" android:paddingTop="12dp" android:paddingEnd="19dp" android:paddingBottom="8dp" android:scrollbars="none" />
            <TextView android:id="@+id/large_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:text="@string/no_large_files_found" android:textColor="#FF92939A" android:textSize="14sp" android:visibility="gone" />
        </FrameLayout>

        <TextView android:id="@+id/large_clean" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginStart="38dp" android:layout_marginTop="8dp" android:layout_marginEnd="38dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_clean_result_button" android:gravity="center" android:text="@string/clean" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>

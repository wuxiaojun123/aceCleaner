<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView android:id="@+id/network_app_icon" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/network_app_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FF35363B" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/network_app_package" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="middle" android:maxLines="1" android:textColor="#FF9A9BA2" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/network_app_usage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF676B83" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>

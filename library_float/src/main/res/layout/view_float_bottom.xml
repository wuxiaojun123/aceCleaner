<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_66000000">

    <LinearLayout
        android:id="@+id/cl_all_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/float_panel_surface"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/clBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@mipmap/ic_launcher" />
                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/string_app_name"
                    android:textColor="@color/color_FF171D27"
                    android:textSize="16sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="144dp"
                android:layout_height="144dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp">
                <com.nice.library_float.FloatPulseView
                    android:id="@+id/animCheck"
                    android:contentDescription="@string/string_m_check"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <LinearLayout
                    android:id="@+id/clTipCheckValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:importantForAccessibility="noHideDescendants">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvCheckValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:textColor="@color/color_FFFFFFFF"
                            android:textSize="36sp"
                            tools:text="88" />
                        <TextView
                            android:id="@+id/tvCheckUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:text="@string/string_float_percent_symbol"
                            android:textColor="@color/color_FFFFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/string_m_check"
                        android:textColor="@color/color_FFFFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/float_traffic_background"
                android:padding="12dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvNetUp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:drawableStart="@drawable/float_ic_upload"
                    android:drawablePadding="8dp"
                    android:textColor="@color/color_FF788392"
                    android:textSize="13sp"
                    android:maxLines="1"
                    tools:text="0 B/s" />
                <TextView
                    android:id="@+id/tvNetDown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:gravity="center"
                    android:drawableStart="@drawable/float_ic_download"
                    android:drawablePadding="8dp"
                    android:textColor="@color/color_FF788392"
                    android:textSize="13sp"
                    android:maxLines="1"
                    tools:text="0 B/s" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <TextView android:id="@+id/tvImageClean" style="@style/FloatPanelFeature"
                    android:drawableTop="@drawable/float_ic_photo" android:text="@string/string_image_clean" />
                <TextView android:id="@+id/tvJunkClean" style="@style/FloatPanelFeature"
                    android:drawableTop="@drawable/float_ic_clean" android:text="@string/string_junk_clean" />
                <TextView android:id="@+id/tvAppProcess" style="@style/FloatPanelFeature"
                    android:drawableTop="@drawable/float_ic_apps" android:text="@string/string_app_processes" />
                <TextView android:id="@+id/tvNotifyClean" style="@style/FloatPanelFeature"
                    android:drawableTop="@drawable/float_ic_notification" android:text="@string/string_notify_clean" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nice_push_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp" android:background="#FFFFFFFF" android:elevation="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/nice_push_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FF202124" android:textStyle="bold" android:textSize="16sp" />
        <TextView android:id="@+id/nice_push_close" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="@string/string_push_close_symbol" android:textColor="#FF202124" android:contentDescription="@string/nice_push_close" />
    </LinearLayout>
    <TextView android:id="@+id/nice_push_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF202124" android:textSize="14sp" />
    <ImageView android:id="@+id/nice_push_image" android:layout_width="match_parent" android:layout_height="120dp" android:scaleType="centerCrop" android:contentDescription="@string/nice_push_image" />
    <TextView android:id="@+id/nice_push_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:textColor="#FF1565C0" />
</LinearLayout>

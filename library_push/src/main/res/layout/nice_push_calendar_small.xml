<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/nice_push_root" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/nice_push_calendar_background" android:padding="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="32dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
            <LinearLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/nice_push_calendar_card" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/nice_push_day" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="27sp" android:textColor="@color/color_FF183153" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:id="@+id/nice_push_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/color_FF183153" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
                <TextView android:id="@+id/nice_push_weekday" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/color_FF2563EB" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
                <TextView android:id="@+id/nice_push_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/color_FF59708B" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/nice_push_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/color_FF59708B" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/nice_push_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/nice_push_close" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="top|end" android:gravity="center" android:text="@string/string_push_close_symbol" android:textSize="22sp" android:textColor="@color/color_FF59708B" android:contentDescription="@string/nice_push_close" />
</FrameLayout>